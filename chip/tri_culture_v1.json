{
  "id": "tri_culture_v1",
  "name": "Three-lineage differentiation and interaction chip v1",
  "description": "Three independent differentiation lanes on one 140 x 75 mm board, each a two-stage pair, with the three mature chambers packed 0.5 mm apart so they can be linked by a microgroove barrier. iPSCs enter once through inlet_1 and are distributed to the three stage-1 chambers; after that every lane is fed and drained through its own dedicated port, so no two lanes ever share liquid. Lane feeds pass through the stage-1 chamber into the stage-2 chamber, which is empty until the passage step, so the only shared junctions are inside a single lane. nx = neural lane, mx = myeloid lane, ax = astroglial lane; the myeloid lane sits in the middle so it borders both others. mc_nx_mx and mc_mx_ax each stand for an ARRAY of about 100 parallel microgrooves, 10 um wide x 3 um high x 500 um long, not one channel: the schema can only express one, so width_mm and depth_mm give the single-groove cross-section. Those grooves pass soluble factors, vesicles and axons but mostly block cell bodies. They are not valves and cannot be closed; isolation is a maintained hydrostatic or perfusion condition, opened by levelling it. The groove layer cannot be laser-cut at 3 um and is cast in PDMS from a photolithographic master; everything else is cut from the 0.3 mm spacer. Geometry and flow numbers are ours; the schedules they serve cite published protocols in protocols/tri_culture_v1.json.",
  "placeholder": false,
  "units": "mm",
  "footprint": { "x": 140, "y": 75 },
  "layers": [
    { "id": "base", "material": "glass", "thickness_mm": 1 },
    { "id": "grooves", "material": "pdms", "thickness_mm": 0.5 },
    { "id": "spacer", "material": "acrylic", "thickness_mm": 0.3 },
    { "id": "lid", "material": "acrylic", "thickness_mm": 3 }
  ],
  "chambers": [
    { "id": "nx_induct", "type": "exchange", "center": [40, 50, 1.65], "size": [20, 12, 0.3], "mesh_pore_um": null, "volume_ul": 72 },
    { "id": "mx_hemo", "type": "exchange", "center": [40, 37.5, 1.65], "size": [20, 12, 0.3], "mesh_pore_um": null, "volume_ul": 72 },
    { "id": "ax_expand", "type": "exchange", "center": [40, 25, 1.65], "size": [20, 12, 0.3], "mesh_pore_um": null, "volume_ul": 72 },
    { "id": "nx_mature", "type": "exchange", "center": [75, 50, 1.65], "size": [20, 12, 0.3], "mesh_pore_um": 5, "volume_ul": 72 },
    { "id": "mx_mature", "type": "exchange", "center": [75, 37.5, 1.65], "size": [20, 12, 0.3], "mesh_pore_um": 5, "volume_ul": 72 },
    { "id": "ax_mature", "type": "exchange", "center": [75, 25, 1.65], "size": [20, 12, 0.3], "mesh_pore_um": 5, "volume_ul": 72 },
    { "id": "mix_1", "type": "pool", "center": [110, 37.5, 1.65], "size": [16, 10, 0.3], "mesh_pore_um": 5, "volume_ul": 48 }
  ],
  "channels": [
    { "id": "ch_seed_nx", "from": "inlet_1", "to": "nx_induct", "width_mm": 0.8, "depth_mm": 0.3 },
    { "id": "ch_seed_mx", "from": "inlet_1", "to": "mx_hemo", "width_mm": 0.8, "depth_mm": 0.3 },
    { "id": "ch_seed_ax", "from": "inlet_1", "to": "ax_expand", "width_mm": 0.8, "depth_mm": 0.3 },

    { "id": "ch_feed_nx", "from": "in_n", "to": "nx_induct", "width_mm": 0.8, "depth_mm": 0.3 },
    { "id": "ch_feed_mx", "from": "in_m", "to": "mx_hemo", "width_mm": 0.8, "depth_mm": 0.3 },
    { "id": "ch_feed_ax", "from": "in_a", "to": "ax_expand", "width_mm": 0.8, "depth_mm": 0.3 },

