{
  "kind": "protocol_ir",
  "id": "spc_capsule_workflow",
  "name": "Semi-permeable capsule (SPC) workflow",
  "goal": "Prepare adherent cells, encapsulate them in semi-permeable capsules, process them inside the capsules (lysis, reverse transcription, indexing PCR), release cDNA and purify and measure a library.",
  "source": {
    "kind": "protocol",
    "file": "autochip/examples/spc_capsule_protocol.md",
    "title": "Semi-permeable capsule (SPC) workflow: generic protocol",
    "citation": "Leonaviciene & Mazutis, Nucleic Acids Research 2023; Baronas et al., Science 2026"
  },
  "placeholder": true,
  "assumptions": [
    "The source states all values are placeholders for illustration, not a validated recipe.",
    "Time ranges use the upper value (15-30 min cold hold taken as 30 min).",
    "Step 6 wash is represented as a resuspend step with 2 repeats (initial wash plus one repeat).",
    "Lysis, RT, PCR cycles and shell-digestion times and temperatures are not stated and are left null.",
    "Emulsion breaking is taken to turn the gelled droplets into capsules.",
    "The unspecified 'buffer' used for rinsing and capsule washes is taken to be wash_buffer.",
    "Culture medium is assumed as the reagent for culture.",
    "Culture duration of 3 days converted to 259200 s.",
    "Four index primer mixes are represented by a single generic reagent."
  ],
  "materials": [
    {
      "id": "cells",
      "kind": "cells"
    },
    {
      "id": "droplets",
      "kind": "droplets",
      "size_um": 70
    },
    {
      "id": "capsules",
      "kind": "capsules",
      "size_um": 70
    },
    {
      "id": "nucleic_acid",
      "kind": "nucleic_acid"
    },
    {
      "id": "beads",
      "kind": "beads"
    },
    {
      "id": "library",
      "kind": "library"
    }
  ],
  "reagents": [
    {
      "id": "culture_medium",
      "role": "maintain cells in culture"
    },
    {
      "id": "wash_buffer",
      "role": "rinse and wash cells and capsules"
    },
    {
      "id": "dissociation_enzyme",
      "role": "detach cells"
    },
    {
      "id": "quench_medium",
      "role": "stop the dissociation enzyme"
    },
    {
      "id": "core_solution",
      "role": "suspend cells for encapsulation"
    },
    {
      "id": "shell_polymer",
      "role": "form the capsule shell",
      "viscous": true
    },
    {
      "id": "fluorinated_oil",
      "role": "continuous oil phase with surfactant for droplet formation",
      "immiscible": true
    },
    {
      "id": "emulsion_breaking_agent",
      "role": "break the emulsion and remove oil"
    },
    {
      "id": "photoinitiator",
      "role": "enable photocuring of the shells"
    },
    {
      "id": "lysis_buffer",
      "role": "lyse cells inside capsules"
    },
    {
      "id": "rt_mix",
      "role": "reverse transcription inside capsules"
    },
    {
      "id": "index_pcr_mix",
      "role": "index PCR with a different index primer mix per portion"
    },
    {
      "id": "shell_digesting_enzyme",
      "role": "digest capsule shells to release cDNA"
    },
    {
      "id": "magnetic_beads",
      "role": "capture the library"
    },
    {
      "id": "ethanol_wash",
      "role": "wash beads"
    },
    {
      "id": "elution_buffer",
      "role": "elute the library (water)"
    }
  ],
  "steps": [
    {
      "n": 1,
      "text": "Culture adherent cells in a vessel at 37 C with 5% CO2 until confluent, changing the medium daily.",
      "action": "culture",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "culture_medium"
      ],
      "duration_s": 259200,
      "temp_c": 37,
      "conditions": {
        "co2": true
      },
      "equipment": [
        "co2_incubator"
      ],
      "on_chip_hint": "off_chip",
      "source_ref": "step 1",
      "assumed": false,
      "note": "Placeholder: 3 days, daily medium change."
    },
    {
      "n": 2,
      "text": "Remove the medium and rinse the cells once with buffer.",
      "action": "wash_cells",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "wash_buffer"
      ],
      "volume_ul": 200,
      "repeats": 1,
      "on_chip_hint": "possible",
      "source_ref": "step 2",
      "assumed": false
    },
    {
      "n": 3,
      "text": "Add dissociation enzyme and incubate to detach the cells.",
      "action": "dissociate",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "dissociation_enzyme"
      ],
      "volume_ul": 100,
      "duration_s": 300,
      "temp_c": 37,
      "on_chip_hint": "possible",
      "source_ref": "step 3",
      "assumed": false
    },
    {
      "n": 4,
      "text": "Add quench medium and mix gently to stop the enzyme.",
      "action": "quench",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "quench_medium"
      ],
      "volume_ul": 200,
      "on_chip_hint": "possible",
      "source_ref": "step 4",
      "assumed": false
    },
    {
      "n": 5,
      "text": "Centrifuge the cells and remove the supernatant.",
      "action": "centrifuge",
      "input_material": "cells",
      "output_material": "cells",
      "duration_s": 300,
      "equipment": [
        "centrifuge"
      ],
      "on_chip_hint": "off_chip",
      "source_ref": "step 5",
      "assumed": false,
      "note": "300 g."
    },
    {
      "n": 6,
      "text": "Resuspend the pellet in wash buffer to wash the cells; repeat the wash once.",
      "action": "resuspend",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "wash_buffer"
      ],
      "volume_ul": 500,
      "repeats": 2,
      "on_chip_hint": "possible",
      "source_ref": "step 6",
      "assumed": false,
      "note": "Total of 2 washes."
    },
    {
      "n": 7,
      "text": "Pass the suspension through a 40 um cell strainer.",
      "action": "filter",
      "input_material": "cells",
      "output_material": "cells",
      "equipment": [
        "cell_strainer"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 7",
      "assumed": false
    },
    {
      "n": 8,
      "text": "Count the cells and check viability.",
      "action": "count",
      "input_material": "cells",
      "output_material": "cells",
      "equipment": [
        "cell_counter"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 8",
      "assumed": false
    },
    {
      "n": 9,
      "text": "Resuspend the cells in core solution at the loading density.",
      "action": "resuspend",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "core_solution"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 9",
      "assumed": false,
      "note": "Placeholder density 2 x 10^6 cells/mL."
    },
    {
      "n": 10,
      "text": "Co-flow the cell/core solution with warm shell polymer solution and focus with fluorinated oil with surfactant at a flow-focusing junction to form droplets of about 70 um.",
      "action": "encapsulate",
      "input_material": "cells",
      "output_material": "droplets",
      "reagents": [
        "core_solution",
        "shell_polymer",
        "fluorinated_oil"
      ],
      "flow_ul_min": null,
      "equipment": [
        "syringe_pumps"
      ],
      "on_chip_hint": "required",
      "source_ref": "step 10",
      "assumed": false,
      "note": "Placeholder flows: core 2, shell 2, oil 10 uL/min. Shell solution kept warm."
    },
    {
      "n": 11,
      "text": "Collect the emulsion and keep it on ice so the shell gels.",
      "action": "incubate",
      "input_material": "droplets",
      "output_material": "droplets",
      "duration_s": 1800,
      "temp_c": 4,
      "conditions": {
        "cold": true
      },
      "equipment": [
        "ice_bath"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 11",
      "assumed": false,
      "note": "Range 15-30 min; upper value used."
    },
    {
      "n": 12,
      "text": "Break the emulsion with an emulsion-breaking agent and remove the oil phase.",
      "action": "break_emulsion",
      "input_material": "droplets",
      "output_material": "capsules",
      "reagents": [
        "emulsion_breaking_agent"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 12",
      "assumed": false
    },
    {
      "n": 13,
      "text": "Photocure the capsule shells with 405 nm light in the presence of photoinitiator.",
      "action": "cure",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "photoinitiator"
      ],
      "duration_s": 30,
      "conditions": {
        "light_nm": 405
      },
      "equipment": [
        "light_source_405nm"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 13",
      "assumed": false
    },
    {
      "n": 14,
      "text": "Wash the capsules in buffer to remove oil and free reagents.",
      "action": "wash_particles",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "wash_buffer"
      ],
      "repeats": 3,
      "on_chip_hint": "possible",
      "source_ref": "step 14",
      "assumed": false
    },
    {
      "n": 15,
      "text": "Filter the capsules through a 100 um strainer to remove aggregates.",
      "action": "filter",
      "input_material": "capsules",
      "output_material": "capsules",
      "equipment": [
        "cell_strainer"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 15",
      "assumed": false
    },
    {
      "n": 16,
      "text": "Exchange the buffer for lysis buffer and incubate.",
      "action": "lyse",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "lysis_buffer"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 16",
      "assumed": false,
      "note": "Time and temperature are placeholders, not given."
    },
    {
      "n": 17,
      "text": "Wash the capsules in wash buffer.",
      "action": "wash_particles",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "wash_buffer"
      ],
      "repeats": 3,
      "on_chip_hint": "possible",
      "source_ref": "step 17",
      "assumed": false
    },
    {
      "n": 18,
      "text": "Exchange into reverse transcription mix and incubate.",
      "action": "reverse_transcribe",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "rt_mix"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 18",
      "assumed": false,
      "note": "Time and temperature are placeholders, not given."
    },
    {
      "n": 19,
      "text": "Wash the capsules.",
      "action": "wash_particles",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "wash_buffer"
      ],
      "repeats": 2,
      "on_chip_hint": "possible",
      "source_ref": "step 19",
      "assumed": false
    },
    {
      "n": 20,
      "text": "Split the capsules into four equal portions.",
      "action": "split",
      "input_material": "capsules",
      "output_material": "capsules",
      "on_chip_hint": "possible",
      "source_ref": "step 20",
      "assumed": false,
      "note": "Four portions."
    },
    {
      "n": 21,
      "text": "Run index PCR on each portion with a different index primer mix.",
      "action": "amplify",
      "input_material": "capsules",
      "output_material": "capsules",
      "reagents": [
        "index_pcr_mix"
      ],
      "equipment": [
        "thermocycler"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 21",
      "assumed": false,
      "note": "Number of cycles is a placeholder, not given."
    },
    {
      "n": 22,
      "text": "Release the cDNA by digesting the capsule shells with a shell-digesting enzyme.",
      "action": "release",
      "input_material": "capsules",
      "output_material": "nucleic_acid",
      "reagents": [
        "shell_digesting_enzyme"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 22",
      "assumed": false,
      "note": "Time and temperature are placeholders, not given."
    },
    {
      "n": 23,
      "text": "Bind the library to magnetic beads.",
      "action": "bind_beads",
      "input_material": "nucleic_acid",
      "output_material": "beads",
      "reagents": [
        "magnetic_beads"
      ],
      "equipment": [
        "magnetic_stand"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 23",
      "assumed": false
    },
    {
      "n": 24,
      "text": "Wash the beads with ethanol wash solution on a magnet.",
      "action": "wash_particles",
      "input_material": "beads",
      "output_material": "beads",
      "reagents": [
        "ethanol_wash"
      ],
      "repeats": 2,
      "conditions": {
        "magnet": true
      },
      "equipment": [
        "magnetic_stand"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 23",
      "assumed": false
    },
    {
      "n": 25,
      "text": "Elute the library from the beads in water.",
      "action": "elute",
      "input_material": "beads",
      "output_material": "library",
      "reagents": [
        "elution_buffer"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 23",
      "assumed": false
    },
    {
      "n": 26,
      "text": "Measure library concentration and fragment size.",
      "action": "measure",
      "input_material": "library",
      "output_material": "library",
      "equipment": [
        "fluorometer"
      ],
      "on_chip_hint": "off_chip",
      "source_ref": "step 24",
      "assumed": false
    }
  ]
}