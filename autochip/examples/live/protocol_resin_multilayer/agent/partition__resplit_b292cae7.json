    "4": "chip1_rinse_dissociation_quench_wash_encapsulation.quench_join",
    "5": "chip1_rinse_dissociation_quench_wash_encapsulation.cell_wash",
    "6": "chip1_rinse_dissociation_quench_wash_encapsulation.cell_wash",
    "7": "missing",
    "8": "off_chip",
    "9": "chip1_rinse_dissociation_quench_wash_encapsulation.core_join",
    "10": "chip1_rinse_dissociation_quench_wash_encapsulation.droplets_1",
    "11": "chip2_gelation_emulsion_break_cure_wash.gelation_delay",
    "12": "chip2_gelation_emulsion_break_cure_wash.capsule_trap",
    "13": "chip2_gelation_emulsion_break_cure_wash.capsule_trap",
    "14": "chip2_gelation_emulsion_break_cure_wash.capsule_trap",
    "15": "chip3_filter_lysis_rt_wash.aggregate_filter",
    "16": "chip3_filter_lysis_rt_wash.reaction_trap",
    "17": "chip3_filter_lysis_rt_wash.reaction_trap",
