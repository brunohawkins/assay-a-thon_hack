    "19": "chip3_filter_lysis_rt_wash.reaction_trap",
    "20": "off_chip",
    "21": "off_chip",
    "22": "chip4_shell_release_bead_capture_wash_elution.release_trap",
    "23": "chip4_shell_release_bead_capture_wash_elution.beads_1",
    "24": "chip4_shell_release_bead_capture_wash_elution.beads_1",
