# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Secrets: never commit keys
.env
.env.*
*.key

# Node (if anyone adds tooling)
node_modules/

# OS / editor
.DS_Store
Thumbs.db

# Local-only files (lab notes, real protocols, anything confidential)
private/

# Generated by chip/nl_to_spec/nl_to_spec.py; copy good specs into chip/ to commit them
chip/nl_to_spec/out/
.venv/

# OpenFOAM case directories (assay2chip/foam). A single chip case is 1-3 M cells: the
# mesh alone is tens of MB and every written time directory is as big again, so the bulk
# is ignored and only the small, meaningful artefacts are kept.
#
# The pattern is deny-then-allow, and ORDER MATTERS - the un-ignore rules below have no
# effect unless the directories leading to them are still walked, which is why the first
# rule names FILES inside the case subtrees rather than the case directory itself.
#
#   IGNORED   constant/polyMesh (the mesh), every time directory (0.1/, 500/, ...),
#             processor*/ (the parallel decomposition), logs, VTK/, the 0/ inputs.
#   KEPT      *.json  - the case summary and the run manifest: what was run, which
#                       OpenFOAM, which fluid, whether it converged;
#             *.png, *.mp4, *.gltf - renders, which are the point of the exercise;
#             *.md, *.csv - any written-up result.
assay2chip/work/**/foam/**
!assay2chip/work/**/foam/**/
!assay2chip/work/**/foam/**/*.json
!assay2chip/work/**/foam/**/*.png
!assay2chip/work/**/foam/**/*.mp4
!assay2chip/work/**/foam/**/*.gltf
!assay2chip/work/**/foam/**/*.md
!assay2chip/work/**/foam/**/*.csv
# Case output is never worth keeping even when it has a kept extension: postProcessing
# writes .dat, foamToVTK writes into VTK/, and a reconstructed time directory can hold a
# .json nobody wrote on purpose.
assay2chip/work/**/foam/**/processor*/
assay2chip/work/**/foam/**/VTK/
assay2chip/work/**/foam/**/polyMesh/

# Public twin bundle, built by tools/build_twin_site.py
_site/

# Pipeline run outputs (stage files, CFD fields, OpenFOAM cases, renders): generated, never source.
assay2chip/work/
