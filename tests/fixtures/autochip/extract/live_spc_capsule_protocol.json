      "on_chip_hint": "possible",
      "source_ref": "step 8",
      "assumed": false
    },
    {
      "n": 9,
      "text": "Resuspend the cells in core solution at the loading density.",
      "action": "resuspend",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "core_solution"
      ],
      "volume_ul": null,
      "duration_s": null,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "pipette"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 9",
      "assumed": false,
      "note": "Placeholder loading density 2 x 10^6 cells/mL."
    },
    {
      "n": 10,
      "text": "Co-flow the cell/core solution with the warm shell polymer solution and focus with surfactant-containing fluorinated oil at a flow-focusing junction to make droplets.",
