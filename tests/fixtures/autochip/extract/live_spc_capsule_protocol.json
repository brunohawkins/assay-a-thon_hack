      "text": "Pass the cell suspension through a cell strainer.",
      "action": "filter",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [],
      "volume_ul": null,
      "duration_s": null,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "cell_strainer"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 7",
      "assumed": false,
      "note": "40 um strainer."
    },
    {
      "n": 8,
      "text": "Count the cells and check viability.",
      "action": "count",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [],
      "volume_ul": null,
      "duration_s": null,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "cell_counter"
