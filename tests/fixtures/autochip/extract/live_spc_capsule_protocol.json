{
  "kind": "protocol_ir",
  "id": "spc_capsule_workflow",
  "name": "Semi-permeable capsule (SPC) workflow",
  "goal": "Generic workflow that prepares adherent cells, encapsulates them in semi-permeable capsules, processes their nucleic acid inside the capsules (lysis, reverse transcription, indexing PCR), then releases and cleans up a library.",
  "source": {
    "kind": "protocol",
    "file": "/tmp/repo_m1/autochip/examples/spc_capsule_protocol.md",
    "title": "Semi-permeable capsule (SPC) workflow: generic protocol",
    "citation": "Leonaviciene & Mazutis, Nucleic Acids Research 2023; Baronas et al., Science 2026"
  },
  "placeholder": true,
  "assumptions": [
    "The source states all values are placeholders for illustration, not a validated recipe.",
    "Culture duration of 3 days is converted to 259200 s; daily medium change is kept in the note, not as separate feed steps.",
    "The wash with repeat in source step 6 is read as a centrifuge-and-resuspend cell wash done twice in total.",
    "Flow rates for the three streams are placeholders; flow_ul_min holds the oil flow (highest) and the others are in the note.",
    "Gelation on ice given as 15-30 min; the upper value (30 min) is used.",
    "Step 6 of the source (resuspend and wash again) is mapped to a cell wash, so the extra centrifugation per repeat is assumed.",
    "Shell polymer warm temperature is not given, so temp_c is left null.",
    "The index primer mix is declared as a generic reagent; no sequences or recipes are included.",
    "Room temperature for lysis is taken as 22 C.",
    "The four portions after splitting are assumed to be processed in parallel in the indexing PCR, with no re-pooling stated.",
    "The released nucleic acid is assumed to be what binds to the beads, and the final eluted product is called the library."
  ],
  "materials": [
    {
      "id": "cells",
      "kind": "cells"
    },
    {
      "id": "droplets",
      "kind": "droplets",
      "size_um": 70
    },
    {
      "id": "capsules",
      "kind": "capsules"
    },
    {
      "id": "nucleic_acid",
      "kind": "nucleic_acid"
    },
    {
      "id": "beads",
      "kind": "beads"
    },
    {
      "id": "library",
      "kind": "library"
    }
  ],
  "reagents": [
    {
      "id": "culture_medium",
      "role": "grow and maintain the adherent cells"
    },
    {
      "id": "wash_buffer",
      "role": "rinse and wash cells and capsules"
    },
    {
      "id": "dissociation_enzyme",
      "role": "detach the cells from the vessel"
    },
    {
      "id": "quench_medium",
      "role": "stop the dissociation enzyme"
    },
    {
      "id": "core_solution",
      "role": "core polymer solution that carries the cells",
      "viscous": true
    },
    {
      "id": "shell_polymer",
      "role": "photocurable shell polymer that forms the capsule shell",
      "viscous": true
    },
    {
      "id": "fluorinated_oil",
      "role": "continuous oil phase with surfactant for droplet formation",
      "immiscible": true
    },
    {
      "id": "emulsion_breaker",
      "role": "remove the oil and break the emulsion"
    },
    {
      "id": "photoinitiator",
      "role": "enable photocuring of the shell"
    },
    {
      "id": "lysis_buffer",
      "role": "lyse the cells inside capsules"
    },
    {
      "id": "rt_mix",
      "role": "reverse transcribe RNA inside capsules"
    },
    {
      "id": "pcr_mix",
      "role": "amplification reagents for indexing PCR"
    },
    {
      "id": "index_primer_mix",
      "role": "add a different index to each portion"
    },
    {
      "id": "shell_digesting_enzyme",
      "role": "digest the capsule shell to release the contents"
    },
    {
      "id": "magnetic_beads",
      "role": "capture the library for clean-up"
    },
    {
      "id": "ethanol_wash",
      "role": "wash beads while on a magnet"
    },
    {
      "id": "elution_buffer",
      "role": "release the library from beads"
    }
  ],
  "steps": [
    {
      "n": 1,
      "text": "Culture adherent cells in a culture vessel in a CO2 incubator until confluent.",
      "action": "culture",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "culture_medium"
      ],
      "volume_ul": null,
      "duration_s": 259200,
      "temp_c": 37,
      "repeats": null,
      "flow_ul_min": null,
      "conditions": {
        "co2": true
      },
      "equipment": [
        "co2_incubator",
        "culture_vessel"
      ],
      "on_chip_hint": "off_chip",
      "source_ref": "step 1",
      "assumed": false,
      "note": "5% CO2; placeholder 3 days with daily medium change."
    },
    {
      "n": 2,
      "text": "Remove the medium and rinse the cells once with buffer.",
      "action": "wash_cells",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "wash_buffer"
      ],
      "volume_ul": 200,
      "duration_s": null,
      "temp_c": null,
      "repeats": 1,
      "flow_ul_min": null,
      "equipment": [
        "pipette"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 2",
      "assumed": false
    },
    {
