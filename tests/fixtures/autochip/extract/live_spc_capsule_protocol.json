      "volume_ul": null,
      "duration_s": null,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": 10,
      "equipment": [
        "syringe_pumps"
      ],
      "on_chip_hint": "required",
      "source_ref": "step 10",
      "assumed": false,
      "note": "Droplets about 70 um. Placeholder flows: core 2, shell 2, oil 10 uL/min (flow_ul_min holds the oil flow). Shell polymer kept warm."
    },
    {
      "n": 11,
      "text": "Collect the emulsion.",
      "action": "collect",
      "input_material": "droplets",
      "output_material": "droplets",
      "reagents": [],
      "volume_ul": null,
      "duration_s": null,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "collection_tube"
