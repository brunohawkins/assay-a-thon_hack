      "output_material": "cells",
      "reagents": [
        "dissociation_enzyme"
      ],
      "volume_ul": 100,
      "duration_s": 300,
      "temp_c": 37,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "incubator"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 3",
      "assumed": false
    },
    {
      "n": 4,
      "text": "Add quench medium and mix gently to stop the enzyme.",
      "action": "quench",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "quench_medium"
      ],
      "volume_ul": 200,
      "duration_s": null,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "pipette"
      ],
      "on_chip_hint": "possible",
      "source_ref": "step 4",
      "assumed": false
    },
    {
      "n": 5,
      "text": "Centrifuge the cells and remove the supernatant.",
      "action": "centrifuge",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [],
      "volume_ul": null,
      "duration_s": 300,
      "temp_c": null,
      "repeats": null,
      "flow_ul_min": null,
      "equipment": [
        "centrifuge"
      ],
      "on_chip_hint": "off_chip",
      "source_ref": "step 5",
      "assumed": false,
      "note": "300 g."
    },
    {
      "n": 6,
      "text": "Resuspend the cell pellet in wash buffer and wash again (two washes in total).",
      "action": "wash_cells",
      "input_material": "cells",
      "output_material": "cells",
      "reagents": [
        "wash_buffer"
      ],
      "volume_ul": 500,
      "duration_s": null,
      "temp_c": null,
      "repeats": 2,
      "flow_ul_min": null,
      "equipment": [
        "centrifuge"
      ],
      "on_chip_hint": "off_chip",
      "source_ref": "step 6",
      "assumed": false,
      "note": "Repeat the wash once, so 2 washes in total; the spin per repeat is assumed."
