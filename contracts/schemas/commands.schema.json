{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capsule-processor.local/schemas/commands.schema.json",
  "title": "Command",
  "description": "One operator command: the chip's whole instruction set. Each $defs entry is the argument object for one command; operator/llm_operator.py turns them into Claude API tools. There is no `valve` command: on-chip valves need a second fluidic layer, contracts/blocks.json excludes them, no chip spec declares one, and routing is done by which port is fed, vented or capped. The rig's off-chip pinch valves are hardware, not a command.",
  "type": "object",
  "required": ["command", "args"],
  "properties": {
    "command": { "enum": ["load", "exchange", "hold_temp", "split", "pool", "release", "culture", "collect", "harvest", "encapsulate", "cure", "mix", "transfer", "count"] },
    "args": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "command": { "const": "load" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/load" } } }
    },
    {
      "if": { "properties": { "command": { "const": "exchange" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/exchange" } } }
    },
    {
      "if": { "properties": { "command": { "const": "hold_temp" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/hold_temp" } } }
    },
    {
      "if": { "properties": { "command": { "const": "split" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/split" } } }
    },
    {
      "if": { "properties": { "command": { "const": "pool" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/pool" } } }
    },
    {
      "if": { "properties": { "command": { "const": "release" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/release" } } }
    },
    {
      "if": { "properties": { "command": { "const": "culture" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/culture" } } }
    },
    {
      "if": { "properties": { "command": { "const": "collect" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/collect" } } }
    },
    {
      "if": { "properties": { "command": { "const": "harvest" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/harvest" } } }
    },
    {
      "if": { "properties": { "command": { "const": "encapsulate" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/encapsulate" } } }
    },
    {
      "if": { "properties": { "command": { "const": "cure" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/cure" } } }
    },
    {
      "if": { "properties": { "command": { "const": "mix" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/mix" } } }
    },
    {
      "if": { "properties": { "command": { "const": "transfer" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/transfer" } } }
    },
    {
      "if": { "properties": { "command": { "const": "count" } }, "required": ["command"] },
      "then": { "properties": { "args": { "$ref": "#/$defs/count" } } }
    }
  ],
  "$defs": {
    "load": {
      "title": "load(target, volume_ul)",
      "description": "Bring a suspension of capsules in through the inlet and settle them in a chamber.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "volume_ul"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber id that receives the capsules." },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0, "description": "Volume of capsule suspension, in microlitres." }
      }
    },
    "exchange": {
      "title": "exchange(target, reagent, volume_ul, washes, flow_ul_min)",
      "description": "Flow a reagent through a chamber and drain it, repeated `washes` times. Capsules stay on the mesh.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reagent", "volume_ul", "washes", "flow_ul_min"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber id." },
        "reagent": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Generic reagent name, snake_case." },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0, "description": "Volume per wash, in microlitres." },
        "washes": { "type": "integer", "minimum": 1, "description": "Number of fill-and-drain cycles." },
        "flow_ul_min": { "type": "number", "exclusiveMinimum": 0, "description": "Flow rate, in microlitres per minute." },
        "direction": {
          "enum": ["forward", "backflush"],
          "description": "Optional. forward (default): in from the inlet, out through the retention to waste. backflush: in from below the retention, lifting capsules off it."
        },
        "waste": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Optional. Outlet port to drain to (e.g. a dedicated oil waste)." }
      }
    },
    "hold_temp": {
      "title": "hold_temp(target, temp_c, duration_s)",
      "description": "Hold a chamber at a temperature for a time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "temp_c", "duration_s"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber id." },
        "temp_c": { "type": "number", "minimum": -20, "maximum": 120, "description": "Temperature in degrees C." },
        "duration_s": { "type": "number", "exclusiveMinimum": 0, "description": "Hold time in seconds." }
      }
    },
    "split": {
      "title": "split(source, targets[])",
      "description": "Divide the capsules in one chamber evenly between several chambers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "targets"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber the capsules leave." },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
          "description": "Chambers the capsules go to."
        }
      }
    },
    "pool": {
      "title": "pool(sources[], target)",
      "description": "Bring the capsules from several chambers together in one chamber.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "target"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
          "description": "Chambers the capsules leave."
        },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber the capsules go to." }
      }
    },
    "release": {
      "title": "release(target, reagent)",
      "description": "Release the product from the capsules in a chamber with a reagent and send it to the outlet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reagent"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber holding the capsules." },
        "reagent": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Generic release reagent name." }
      }
    },
    "culture": {
      "title": "culture(targets[], reagents[], duration_s, exchange_interval_s, volume_ul, flow_ul_min, temp_c)",
      "description": "Keep chambers in culture: every exchange_interval_s a batch of fresh medium (volume_ul at flow_ul_min) flows through each chamber, then the flow stops until the next change.",
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "reagents", "duration_s", "exchange_interval_s", "volume_ul", "flow_ul_min", "temp_c"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }, "description": "Culture chamber ids." },
        "reagents": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }, "description": "Medium for each target, in the same order." },
        "factors": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }, "description": "Optional factor per target, added through each lane's factor port." },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "exchange_interval_s": { "type": "number", "exclusiveMinimum": 0 },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0, "description": "Medium per exchange, per chamber." },
        "flow_ul_min": { "type": "number", "exclusiveMinimum": 0 },
        "temp_c": { "type": "number", "minimum": -20, "maximum": 120 }
      }
    },
    "collect": {
      "title": "collect(targets[], volume_ul)",
      "description": "Take supernatant out of each chamber through its outlet into a collection tube. The cells stay.",
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "volume_ul"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" } },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0, "description": "Per chamber." }
      }
    },
    "harvest": {
      "title": "harvest(targets[], reagent)",
      "description": "Flush the (detached) cells out of each chamber through its outlet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "reagent"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" } },
        "reagent": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Buffer that carries the cells out." }
      }
    },
    "encapsulate": {
      "title": "encapsulate(target, core_flow_ul_h, shell_flow_ul_h, oil_flow_ul_h, capsules)",
      "description": "Make capsules: core (cells in dextran) and shell (GelMA) streams co-flow into the nozzle, oil from both sides pinches off droplets, and each droplet phase-separates into a core-shell capsule.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "core_flow_ul_h", "shell_flow_ul_h", "oil_flow_ul_h", "capsules"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Nozzle junction id." },
        "core_flow_ul_h": { "type": "number", "exclusiveMinimum": 0 },
        "shell_flow_ul_h": { "type": "number", "exclusiveMinimum": 0 },
        "oil_flow_ul_h": { "type": "number", "exclusiveMinimum": 0 },
        "capsules": { "type": "integer", "minimum": 1 }
      }
    },
    "cure": {
      "title": "cure(target, wavelength_nm, duration_s)",
      "description": "Light-cure the capsule shells in a trap (single capsule layer under a curing window).",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "wavelength_nm", "duration_s"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "wavelength_nm": { "type": "number", "exclusiveMinimum": 0 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "mix": {
      "title": "mix(target, reagent, volume_ul, dilution)",
      "description": "Mix a reagent into the cell stream in a mixer chamber (quench in a serpentine; resuspension in a wide, short mixer). dilution: final volume / cell-stream volume.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reagent"],
      "properties": {
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "reagent": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "volume_ul": { "type": "number", "exclusiveMinimum": 0, "description": "Reagent volume." },
        "flow_ul_min": { "type": "number", "exclusiveMinimum": 0 },
        "dilution": { "type": "number", "minimum": 1 }
      }
    },
    "transfer": {
      "title": "transfer(source, target)",
      "description": "Move the cells from one stage to the next (or out through an outlet port), through any filter or window in between.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "description": "Chamber or outlet port." }
      }
    },
    "count": {
      "title": "count(target)",
      "description": "Read the cell concentration and viability at a QC window (a simulated counter for now).",
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": { "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" } }
    }
  }
}
