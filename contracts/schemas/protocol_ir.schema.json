{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol_ir.schema.json",
  "title": "Protocol IR",
  "description": "Stage 1 output of the protocol compiler (autochip/). A wet-lab protocol, paper or plain-English goal turned into an ordered list of typed steps, before anything is put on a chip. Generic reagent names only: no sequences, recipes or lab-specific conditions beyond what the source states. Units: volume uL, time s, temperature C, flow uL/min.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "name",
    "source",
    "placeholder",
    "steps"
  ],
  "properties": {
    "kind": {
      "const": "protocol_ir"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "description": "What the protocol is for, one or two sentences."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "prompt",
            "protocol",
            "paper"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "placeholder": {
      "type": "boolean",
      "description": "true when values were assumed or are stand-ins."
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Everything the agent filled in that the source did not say."
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "cells",
              "capsules",
              "droplets",
              "beads",
              "nucleic_acid",
              "library",
              "lysate",
              "liquid",
              "oil",
              "gel",
              "none"
            ]
          },
          "size_um": {
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "role": {
            "type": "string"
          },
          "viscous": {
            "type": "boolean"
          },
          "immiscible": {
            "type": "boolean",
            "description": "true for oil phases"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "text",
          "action"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "description": "The step in plain English (paraphrased from the source)."
          },
          "action": {
            "enum": [
              "culture",
              "seed",
              "feed",
              "dissociate",
              "quench",
              "add_reagent",
              "mix",
              "incubate",
              "wash_cells",
              "wash_particles",
              "centrifuge",
              "resuspend",
              "filter",
              "count",
              "image",
              "measure",
              "encapsulate",
              "emulsify",
              "cure",
              "break_emulsion",
              "lyse",
              "reverse_transcribe",
              "amplify",
              "fragment",
              "ligate",
              "bind_beads",
              "magnetic_separate",
              "elute",
              "purify",
              "split",
              "pool",
              "release",
              "collect",
              "transfer",
              "store",
              "other"
            ]
          },
          "input_material": {
            "enum": [
              "cells",
              "capsules",
              "droplets",
              "beads",
              "nucleic_acid",
              "library",
              "lysate",
              "liquid",
              "oil",
              "gel",
              "none",
              null
            ]
          },
          "output_material": {
            "enum": [
              "cells",
              "capsules",
              "droplets",
              "beads",
              "nucleic_acid",
              "library",
              "lysate",
              "liquid",
              "oil",
              "gel",
              "none",
              null
            ]
          },
          "reagents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "volume_ul": {
            "type": [
              "number",
              "null"
            ]
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "temp_c": {
            "type": [
              "number",
              "null"
            ]
          },
          "repeats": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "flow_ul_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "light_nm": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "magnet": {
                "type": "boolean"
              },
              "shaking": {
                "type": "boolean"
              },
              "co2": {
                "type": "boolean"
              },
              "thermal_cycles": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "cold": {
                "type": "boolean"
              }
            }
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "on_chip_hint": {
            "enum": [
              "required",
              "possible",
              "off_chip"
            ],
            "description": "Agent's view of whether the step can run in a chip."
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where in the source this came from (section, table row, page)."
          },
          "assumed": {
            "type": "boolean",
            "description": "true if the step was inferred rather than stated."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}